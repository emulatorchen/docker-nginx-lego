FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
LABEL maintainer="emulatorchen"

# FORK: Uses Ubuntu 24.04 (Noble) as the base instead of the official nginx Docker
# image, providing Ubuntu's OpenSSL 3.x and system libraries while installing nginx
# mainline from the official nginx.org repository.
#
# When merging nginx version bumps: update ARG NGINX_VERSION below (check_nginx_update
# workflow handles this automatically).
# When merging lego version bumps: update ARG LEGO_VERSION below.
# Skip all certbot/Python changes from upstream — they are intentionally removed.

ARG NGINX_VERSION=1.31.10
ARG LEGO_VERSION=5.6.0
ARG TARGETARCH
ARG TARGETVARIANT

RUN set -ex && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        gnupg \
        ca-certificates \
    && \
# FORK: create the nginx user as 101:101 like the official nginx images do, so every
# variant runs as the same uid. The nginx package keeps a user that already exists.
    groupadd --system --gid 101 nginx && \
    useradd --system --uid 101 --gid nginx --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin --comment "nginx user" nginx && \
# Add official nginx.org mainline repository for Ubuntu Noble.
    curl -fsSL https://nginx.org/keys/nginx_signing.key \
        | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg && \
    printf 'deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/ubuntu noble nginx\ndeb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/mainline/ubuntu noble nginx\n' \
        > /etc/apt/sources.list.d/nginx.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx=${NGINX_VERSION}-1~noble \
        openssl \
        procps \
    && \
# Mirror the official nginx Docker image: redirect access and error logs to stdout/stderr.
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log && \
# Install the static lego binary for certificate management.
    if [ "${TARGETARCH}" = "arm" ] && [ -n "${TARGETVARIANT}" ]; then \
        ARCH="arm${TARGETVARIANT}"; \
    else \
        ARCH=$(echo "${TARGETARCH:-$(uname -m)}" | sed 's/x86_64/amd64/;s/aarch64/arm64/;s/armv7l/armv7/;s/armv6l/armv6/'); \
    fi && \
    TARBALL="lego_v${LEGO_VERSION}_linux_${ARCH}.tar.gz" && \
    curl -sL "https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/${TARBALL}" \
        -o "/tmp/${TARBALL}" && \
    CHECKSUM=$(curl -sL "https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/lego_${LEGO_VERSION}_checksums.txt" \
        | grep " ${TARBALL}$" | awk '{print $1}') && \
    echo "${CHECKSUM}  /tmp/${TARBALL}" | sha256sum -c - && \
    tar -xz -C /usr/local/bin lego -f "/tmp/${TARBALL}" && \
    rm "/tmp/${TARBALL}" && \
    chmod +x /usr/local/bin/lego && \
# Remove build-only packages.
    apt-get remove --purge -y curl gnupg && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
# Create new directories and set correct permissions.
    mkdir -p /var/www/letsencrypt && \
    mkdir -p /etc/nginx/user_conf.d && \
    chown www-data:www-data -R /var/www && \
# Make sure there are no surprise config files inside the config folder.
    rm -f /etc/nginx/conf.d/*

# Copy in our "default" Nginx server configurations, which make sure that the
# ACME challenge requests are correctly forwarded to lego and then redirects
# everything else to HTTPS.
COPY nginx_conf.d/ /etc/nginx/conf.d/
# FORK: not present upstream. A split setup's server (NGINX_LEGO_ROLE) may run
# with /etc/nginx/conf.d on a tmpfs, which hides the file above; it restores it
# from this copy at start (restore_image_conf in util.sh).
COPY nginx_conf.d/ /usr/local/share/nginx-lego/conf.d/

# Copy in all our scripts and make them executable.
COPY scripts/ /scripts
RUN chmod +x -R /scripts

# FORK: the container runs as the unprivileged nginx user (101:101), not root, so
# that user gets everything written at runtime. Group 0 gets the same access, so a
# platform that starts the container as its own uid in group 0 (OpenShift,
# Kubernetes runAsUser) works too. The 'user' line only matters to a root master
# and goes; the pid file stays in /run, which nginx now owns.
RUN set -e; \
    [ "$(id -u nginx):$(id -g nginx)" = "101:101" ] \
        || { echo "the nginx user is $(id -u nginx):$(id -g nginx), not 101:101" >&2; exit 1; }; \
    sed -i '/^[[:space:]]*user[[:space:]]/d' /etc/nginx/nginx.conf; \
    pid=$(sed -n 's/^[[:space:]]*pid[[:space:]][[:space:]]*\([^;]*\);.*/\1/p' /etc/nginx/nginx.conf); \
    [ "$(readlink -f "$(dirname "${pid}")")" = /run ] \
        || { echo "nginx writes its pid to '${pid}', not into /run" >&2; exit 1; }; \
    mkdir -p /etc/letsencrypt /etc/local_ca /var/cache/nginx /var/www/letsencrypt; \
    chown 101:0 /run; \
    chmod g+rwx /run; \
    chown -R 101:0 /etc/letsencrypt /etc/local_ca /var/cache/nginx /var/www/letsencrypt /etc/nginx/conf.d; \
    chmod -R g+rwX /etc/letsencrypt /etc/local_ca /var/cache/nginx /var/www/letsencrypt /etc/nginx/conf.d

# Create a volume to have persistent storage for the obtained certificates.
VOLUME /etc/letsencrypt

# Applies and checks what the .trivyignore entries rely on; kept last so it also
# covers packages installed by earlier layers, including the CVE pin block.
RUN /scripts/cve_mitigations.sh ubuntu

# FORK: run as the nginx user prepared above.
USER 101:101

# Expose both ports: 80 for ACME HTTP-01 challenges, 443 for HTTPS.
EXPOSE 80 443

# Launch our Nginx and lego management script.
CMD ["/scripts/start_nginx_lego.sh"]
